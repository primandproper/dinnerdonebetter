# gRPC API server URL (host:port).
# Production: api.dinnerdonebetter.com:443 (with DEVELOPING_LOCALLY=false)
# Local dev: localhost:50051 after port-forward (kubectl port-forward svc/api-service 50051:50051)
GRPC_API_SERVER_URL=

# Cookie encryption: base64-encoded 32-byte key for AES-256-GCM
# Generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=

# Cookie name (default: consumer_session)
COOKIE_NAME=consumer_session

# Cookie domain (optional, empty for current host)
COOKIE_DOMAIN=

# Set to "true" for local dev: uses plaintext gRPC instead of TLS
DEVELOPING_LOCALLY=false

# OpenTelemetry collector (optional). When unset, server-side tracing is no-op and the
# browser trace proxy returns 501. Set in deployed environments to the in-cluster collector.
# gRPC (4317) for server-side SDK; HTTP (4318) for the browser OTLP proxy.
# OTEL_COLLECTOR_GRPC_URL=otel-collector-svc.prod.svc.cluster.local:4317
# OTEL_COLLECTOR_HTTP_URL=http://otel-collector-svc.prod.svc.cluster.local:4318

# Base URL for profile avatar images (must match identity service public avatar URL prefix).
# Production: https://<media-bucket>/avatars  Local dev: http://localhost:8000/uploads
PUBLIC_AVATAR_MEDIA_URL_PREFIX=
